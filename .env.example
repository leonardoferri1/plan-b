# ---------------------------------------------------------------------------
# Plan B — example environment. Copy to `.env` and adjust as needed.
# ---------------------------------------------------------------------------

# Postgres (consumed by docker-compose.yml)
POSTGRES_USER=plan-b
POSTGRES_PASSWORD=plan-b
POSTGRES_DB=plan-b
POSTGRES_PORT=5432
ADMINER_PORT=8080

# API (apps/api)
DATABASE_URL=postgresql://plan-b:plan-b@localhost:5432/plan-b?schema=public
API_PORT=3333
CORS_ORIGIN=http://localhost:5173

# Web (apps/web) — Vite only exposes variables prefixed with VITE_
VITE_API_URL=http://localhost:3333
