# ---------------------------------------------------------------------------
# SpaceCraft — example environment. Copy to `.env` and adjust as needed.
# ---------------------------------------------------------------------------

# Postgres (consumed by docker-compose.yml)
POSTGRES_USER=spacecraft
POSTGRES_PASSWORD=spacecraft
POSTGRES_DB=spacecraft
POSTGRES_PORT=5432
ADMINER_PORT=8080

# API (apps/api)
DATABASE_URL=postgresql://spacecraft:spacecraft@localhost:5432/spacecraft?schema=public
API_PORT=3333
CORS_ORIGIN=http://localhost:5173

# Web (apps/web) — Vite only exposes variables prefixed with VITE_
VITE_API_URL=http://localhost:3333
